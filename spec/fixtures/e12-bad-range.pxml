<!-- E12: a descending range
     Ranges (1-4) are for integer ids and ascend. -->
<!-- expect {"outcome": "error", "errors": ["tier-bad-range"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T">
    <set id="s1" members="2-1"/>
  </tier>
</analysis>
