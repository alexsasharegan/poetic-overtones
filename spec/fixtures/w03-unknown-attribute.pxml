<!-- W03: an unknown attribute on a tier or set
     Unknown attributes are kept and reported; x- prefixed ones are the extension space and are silent. -->
<!-- expect {"warnings": ["unknown-attribute"], "sets": {"s1": ["one"], "s2": ["two"]}} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T" colour="red">
    <set id="s1" members="1"/>
  </tier>
  <tier id="t2" name="U" x-note="fine">
    <set id="s2" x-weight="3" members="2"/>
  </tier>
</analysis>
