<!-- Case 07: relations that overlap on the same words.
     Alliteration (the six /p/ onsets) and a repeated rime (ick, in "picked" and
     "pickled") are both relation tiers over the same words. The onset span and the rime
     span are adjacent siblings, so nothing crosses. -->
<!-- expect {"sets": {
  "s1": ["P", "P", "p", "p", "p", "p"],
  "s2": ["ick", "ick"]}} -->

<text>
Peter Piper picked a peck of pickled peppers
</text>

<markup>
<span id="1">P</span>eter <span id="2">P</span>iper <span id="3">p</span><span id="7">ick</span>ed a <span id="4">p</span>eck of <span id="5">p</span><span id="8">ick</span>led <span id="6">p</span>eppers
</markup>

<analysis>
  <tier id="t1" name="Alliteration" kind="relation">
    <set id="s1" name="p" members="1,2,3,4,5,6"/>
  </tier>
  <tier id="t2" name="Repeated rime" kind="relation">
    <set id="s2" name="ick" members="7,8"/>
  </tier>
</analysis>
