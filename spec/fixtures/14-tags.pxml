<!-- Case 14: tags on sets.
     A set may carry tags: space-separated tokens such as place:labial. They let a style
     rule act on a group of sets (the community theme colours by place and voicing).
     The mirror of the analysis shows them on each set element, so a theme can
     select set[tags~="place:labial"] (format S-04). The format does not define any tag;
     themes and tier definitions do. -->
<!-- expect {"sets": {"s1": ["p"], "s2": ["b"]}} -->

<text>
pat bat
</text>

<markup>
<span id="1">p</span>at <span id="2">b</span>at
</markup>

<analysis>
  <tier id="t1" name="Consonants" role="consonant">
    <set id="s1" name="p" members="1" tags="place:labial voiced:false manner:plosive"/>
    <set id="s2" name="b" members="2" tags="place:labial voiced:true manner:plosive"/>
  </tier>
</analysis>

<style>
  set[tags~="place:labial"] { background: #fde3e3; }
  set[tags~="voiced:true"] { font-weight: 700; }
</style>
