<!-- E04: two tiers with the same channel
     The channel is the stable id and the CSS class, so it must be unique. -->
<!-- expect {"outcome": "error", "errors": ["tier-duplicate-channel"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier name="One" channel="x" members="1"/>
  <tier name="Two" channel="x" members="2"/>
</analysis>

