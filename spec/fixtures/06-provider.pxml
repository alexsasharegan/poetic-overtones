<!-- Case 06: providers, confirmation and several tiers on one span.
     The syllable and stress tiers are filled by providers (inferred), so a whole-tier
     reset can restore them. confirmed lists the members a human has accepted. "Hand-marked"
     has no provider: reset never touches it. Span 3 is in three sets at once, which is
     fine because a set is just a list of ids. reads names the tier a provider worked from.
     Members are always listed one by one (no ranges). -->
<!-- expect {"sets": {
  "s_syll": ["Up", "a", "bove", "the", "world", "so", "high"],
  "s_stressed": ["Up", "bove", "world", "high"],
  "s_unstressed": ["a", "the", "so"],
  "s_mine": ["bove"]}} -->

<text>
Up above the world so high,
</text>

<markup>
<span id="1">Up</span> <span id="2">a</span><span id="3">bove</span> <span id="4">the</span> <span id="5">world</span> <span id="6">so</span> <span id="7">high</span>,
</markup>

<analysis>
  <tier id="t_syll" name="Syllables" provider="english.syllable@1">
    <set id="s_syll" name="Syllable" members="1,2,3,4,5,6,7"/>
  </tier>
  <tier id="t_stress" name="Stress" provider="english.stress@1" reads="t_syll">
    <set id="s_stressed" name="stressed" members="1,3,5,7" confirmed="1,7"/>
    <set id="s_unstressed" name="unstressed" members="2,4,6"/>
  </tier>
  <tier id="t_mine" name="Hand-marked">
    <set id="s_mine" name="Mine" members="3"/>
  </tier>
</analysis>
