<!-- E14: directed on a label tier
     Order means something only for relation tiers. -->
<!-- expect {"outcome": "error", "errors": ["directed-without-relation"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T" directed="true">
    <set id="s1" members="1,2"/>
  </tier>
</analysis>
