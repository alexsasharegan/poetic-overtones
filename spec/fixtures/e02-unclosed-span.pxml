<!-- E02: a span that is never closed
     Not well-formed XML. This is also what an attempt to write crossing spans with plain nesting runs into: use fragments sharing an id (case 03). -->
<!-- expect {"outcome": "error", "errors": ["xml-not-wellformed"]} -->

<text>
one two
</text>

<markup>
<span id="1">one <span id="2">two</span>
</markup>

