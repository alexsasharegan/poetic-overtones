<!-- W04: tier names outside ASCII
     With no channel given, the channel is the slug of the name, and the slug is ASCII.
     "Écho" becomes cho and a Shavian name becomes just t, so the loader warns that the
     slug is lossy; the author should give an explicit channel. Two such names would
     collide (tier-slug-collision). -->
<!-- expect {"warnings": ["tier-slug-lossy"], "tiers": {"cho": ["one"], "t": ["two"]}} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier name="Écho" members="1"/>
  <tier name="𐑐𐑑𐑒" members="2"/>
</analysis>
