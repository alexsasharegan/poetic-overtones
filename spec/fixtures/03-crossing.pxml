<!-- Case 03: crossing spans.
     Trochaic feet: UP a | BOVE the | WORLD so | HIGH. Foot 1 ends inside the word "above",
     so feet and word cross. XML cannot express crossing, and ids must be unique, so the
     word is a head span (id="w2") plus a continuation (id="w2b" cont="w2") that points back
     at it. Every span has its own id; a continuation also says which head it continues.
     The logical span's text is the head and its continuations, in document order. Sets
     name the head's id. -->
<!-- expect {"sets": {
  "s1": ["Up a", "bove the", "world so", "high"],
  "s2": ["above"]}} -->

<text>
Up above the world so high,
</text>

<markup>
<span id="f1">Up <span id="w2">a</span></span><span id="f2"><span id="w2b" cont="w2">bove</span> the</span> <span id="f3">world so</span> <span id="f4">high</span>,
</markup>

<analysis>
  <tier id="t1" name="Feet">
    <set id="s1" name="Foot" members="f1,f2,f3,f4"/>
  </tier>
  <tier id="t2" name="Words">
    <set id="s2" name="above" members="w2"/>
  </tier>
</analysis>
