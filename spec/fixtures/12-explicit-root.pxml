<?xml version="1.0" encoding="UTF-8"?>
<!-- Case 12: an explicit root element.
     The same file shape wrapped in <pxml>...</pxml>, which is what a stock XML tool
     expects. Meaning is identical to the bare form. Block content is still dedented. -->
<!-- expect {"sets": {"s1": ["Hello", "world"]}} -->
<pxml version="1">
  <text>
    Hello world
  </text>
  <markup>
    <span id="1">Hello</span> <span id="2">world</span>
  </markup>
  <analysis>
    <tier id="t1" name="Words">
      <set id="s1" name="Word" members="1,2"/>
    </tier>
  </analysis>
</pxml>
