<!-- W02: a style block that can fetch things
     url() and @import are ignored by the loader (offline-first, no tracking) and reported. The file still loads. -->
<!-- expect {"warnings": ["style-url"], "sets": {"s1": ["one"]}} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T">
    <set id="s1" members="1"/>
  </tier>
</analysis>

<style>
  tier > set { background: url("https://example.com/x.png"); }
  @import "https://example.com/y.css";
</style>
