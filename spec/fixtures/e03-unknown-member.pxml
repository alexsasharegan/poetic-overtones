<!-- E03: a set names a span that does not exist
     Every member must be a span id present in the markup. -->
<!-- expect {"outcome": "error", "errors": ["set-unknown-member"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T">
    <set id="s1" members="1,9"/>
  </tier>
</analysis>
