<!-- E10: confirmed names a span that is not a member
     confirmed must be a subset of the set members. -->
<!-- expect {"outcome": "error", "errors": ["confirmed-not-member"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier id="t1" name="T" provider="english.word@1">
    <set id="s1" members="1" confirmed="2"/>
  </tier>
</analysis>
