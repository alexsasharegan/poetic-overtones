<!-- Case W01: a forbidden control character in the input.
     U+0007 cannot appear in XML 1.0. The loader replaces it with U+FFFD and warns; the
     file still loads. -->
<!-- expect {"warnings": ["control-char"], "sets": {"s1": ["bell"]}} -->
<text>
bell here
</text>
<markup>
<span id="1">bell</span> here
</markup>
<analysis>
  <tier id="t1" name="W">
    <set id="s1" members="1"/>
  </tier>
</analysis>
