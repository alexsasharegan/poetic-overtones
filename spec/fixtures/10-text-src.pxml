<!-- Case 10: the input text lives in a file.
     A self-closing <text src="..."/> names a file next to this one: relative path only,
     no "..", no URL. A BOM is ignored and nothing in the file is escaped. The file is
     sliced and dedented exactly like an inline block (its final line end goes; a
     leading blank line stays), so the markup can always reproduce it (case 18). -->
<!-- expect {"sets": {
  "s1": ["Roses are red,", "Violets are blue,"],
  "s2": ["red", "blue"]}} -->

<text src="10-text-src.txt"/>

<markup>
<span id="1">Roses are <span id="3">red</span>,</span>
<span id="2">Violets are <span id="4">blue</span>,</span>
</markup>

<analysis>
  <tier id="t1" name="Lines">
    <set id="s1" name="Line" members="1,2"/>
  </tier>
  <tier id="t2" name="Line ends" kind="relation">
    <set id="s2" name="end" members="3,4"/>
  </tier>
</analysis>
