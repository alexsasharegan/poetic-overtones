<!-- Case 05: enjambment as a directed relation tier.
     Paradise Lost I.1-3 (Milton, public domain). The sense runs from the end of one line
     into the start of the next. The tier is a relation tier and directed, so each set's
     member order matters. One tier, one set per enjambment. -->
<!-- expect {"sets": {
  "s1": ["Of Man's first disobedience, and the fruit",
         "Of that forbidden tree whose mortal taste",
         "Brought death into the world, and all our woe,"],
  "s2": ["fruit", "Of that forbidden tree"],
  "s3": ["taste", "Brought death"]}} -->

<text>
Of Man's first disobedience, and the fruit
Of that forbidden tree whose mortal taste
Brought death into the world, and all our woe,
</text>

<markup>
<span id="l1">Of Man's first disobedience, and the <span id="e1a">fruit</span></span>
<span id="l2"><span id="e1b">Of that forbidden tree</span> whose mortal <span id="e2a">taste</span></span>
<span id="l3"><span id="e2b">Brought death</span> into the world, and all our woe,</span>
</markup>

<analysis>
  <tier id="t1" name="Lines">
    <set id="s1" name="Line" members="l1,l2,l3"/>
  </tier>
  <tier id="t2" name="Enjambment" kind="relation" directed="true">
    <set id="s2" name="1" members="e1a,e1b"/>
    <set id="s3" name="2" members="e2a,e2b"/>
  </tier>
</analysis>
