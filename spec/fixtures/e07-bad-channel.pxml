<!-- E07: a channel that is not a valid class name
     Channels start with a letter: letters, digits, hyphen, underscore. A default slug that would start with a digit gets a t- prefix instead. -->
<!-- expect {"outcome": "error", "errors": ["tier-bad-channel"]} -->

<text>
one two
</text>

<markup>
<span id="1">one</span> <span id="2">two</span>
</markup>

<analysis>
  <tier name="First" channel="1st" members="1"/>
</analysis>

