<!-- Case 09: characters that XML treats specially.
     Only &lt; &gt; &amp; &quot; &apos; exist by name; anything else is a numeric
     reference (&#x2019; is a right single quote). CDATA sections are not part of the
     format (case e15). The two blocks need not escape the same way, only produce the
     same text. Text that is full of such characters is easier to keep in a file and
     reference with <text src="..."/> (case 10), where nothing is escaped. -->
<!-- expect {"tiers": {"sym": ["Tom & Jerry", "<"]}} -->

<text>
Tom &amp; Jerry &lt;3 it&#x2019;s fine
a &lt; b &amp;&amp; c &gt; d
</text>

<markup>
<span id="1">Tom &amp; Jerry</span> &lt;3 it’s fine
a <span id="2">&lt;</span> b &amp;&amp; c &gt; d
</markup>

<analysis>
  <tier name="Symbols" channel="sym" members="1,2"/>
</analysis>
