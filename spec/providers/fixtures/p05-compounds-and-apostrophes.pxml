<!-- Provider fixture P05: a hyphenated word not in the lexicon is tried part by part (moon-light); if any part is missing the whole word is unknown (Elven-king). The lexicon form of an apostrophe is the straight one; the text may use the curly one (summer’s). -->

<text xml:space="preserve">
Summer’s moon-light and Elven-king
</text>

<markup xml:space="preserve">
<span id="1"><span id="2">Sum</span><span id="3">mer’s</span></span> <span id="4"><span id="5">moon</span>-<span id="6">light</span></span> <span id="7">and</span> <span id="8">Elven-king</span>
</markup>

<analysis>
  <tier id="t1" name="Words" provider="english.word@1">
    <set id="s1" name="Word" key="word" members="1,4,7,8"/>
  </tier>
  <tier id="t2" name="Syllables" provider="english.syllable@1" reads="t1">
    <set id="s2" name="Syllable" key="syllable" members="2,3,5,6,7"/>
    <set id="s3" name="Unknown word" key="unknown" tags="status:unknown" members="8"/>
  </tier>
  <tier id="t3" name="Stress" provider="english.stress@1" reads="t1 t2">
    <set id="s4" name="primary" key="primary" tags="stress:primary" members="2,5,6,7"/>
    <set id="s5" name="secondary" key="secondary" tags="stress:secondary" members=""/>
    <set id="s6" name="unstressed" key="unstressed" tags="stress:unstressed" members="3"/>
    <set id="s7" name="Check: other readings" key="check" tags="status:check" members=""/>
    <set id="s8" name="Unmarked" key="unmarked" tags="status:unmarked" members=""/>
  </tier>
</analysis>

